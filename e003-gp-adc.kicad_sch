	)
	(text "MODE HIGH: SPI PROGRAMMING.\nONE DATA LANE ON DOUT0, NO DAISY CHAIN: DIN0 IS TIED\nLOW (GP SHEET) AND DIN1 TO DGND.\nSWITCH ENABLES ON GPIO0..GPIO5 (DOUT2 AND DOUT3 AS GPIO2\nAND GPIO3): DISABLED AT POWER-UP, SO THE CHANNEL STARTS OFF\nRESET FROM THE FPGA, WHOSE PULL-DOWN HOLDS IT IN RESET WHILE IT CONFIGURES"
		(exclude_from_sim no)
		(at 218.44 78.74 0)
		(effects
			(font
