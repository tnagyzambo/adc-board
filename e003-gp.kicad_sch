	(text "SHIELD: CLOSE THE SOLDER JUMPER WHERE THE SHIELDS ARE\nTERMINATED AT THE BOARD. IT TIES GP_SHLD TO GND."
		(exclude_from_sim no)
		(at 20.32 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2324bcb6-f08e-5d26-9965-3ba5af8e358e")
	)
	(text "THE TWO CHANNELS SHARE ONE SUPPLY (POWER). EACH HAS\nITS OWN REFERENCE AND ITS OWN NINE LINES TO THE FPGA\n(CLK, START, SCLK, SDI, CS, SDO, DOUT, FSYNC, RESET):\nNO LINE IS SHARED, SO ONE FAILED CONVERTER CANNOT HOLD\nTHE OTHER'S BUS. DIN, THE DAISY-CHAIN INPUT, IS TIED LOW."
		(exclude_from_sim no)
		(at 91.44 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7cb2cc39-57fc-5973-bca0-101d51d9ae5e")
	)
	(text "ADC: THE FPGA'S LINES TO THE CHANNELS, ON ITS TWO\n1.8 V BANKS, WITH SUPPLY ENABLE AND FAULT. +1V8_CH\nPOWERS THOSE BANKS. +24V_CH, THE SENSOR SUPPLY,\nCOMES FROM THE STACK THROUGH ITS FUSE (STACK SHEET)."
		(exclude_from_sim no)
		(at 20.32 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f3c9db21-93e6-572b-86a4-3a4f97dcdcaf")
	)
