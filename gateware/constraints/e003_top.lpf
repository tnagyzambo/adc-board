# e003-adc-board bring-up gateware: Lattice Diamond preferences for the
# LCMXO2-4000HC-4QN84C (U50).
#
# Pins are taken from the pad nets of U50 in e003-adc-board.kicad_pcb.

# --- Configuration (written to the feature row with the .jed) ---------------
#
# JTAG stays enabled in every image, so a bad image can always be replaced
# through the Tag-Connect. PROGRAMN stays enabled for the reconfiguration
# timer (GW-9). The slave SPI port stays enabled, as GW-8 requires: it owns
# SN (A25), SI (A26), SO (B12) and CCLK (A16), and the design serves the lane
# on its second copy of the pins (PB7B, PB13A, PB13B, PB20A). Whether the
# port then leaves SO alone is the open question of OI-9; if the host reads
# garbage, set SLAVE_SPI_PORT=DISABLE here and rebuild. The master SPI port
# stays disabled until there is a golden image (GW-8), which leaves the
# flash's chip select (CSSPIN, A12) to its pull-up R208. VERIFY the keywords
# against Diamond's preference reference if the build rejects them.
SYSCONFIG JTAG_PORT=ENABLE SDM_PORT=PROGRAMN SLAVE_SPI_PORT=ENABLE MASTER_SPI_PORT=DISABLE I2C_PORT=DISABLE ;

# --- Banks ------------------------------------------------------------------
#
# Banks 1 (ADC1) and 4 (ADC2) run at 1.8 V from the channels' rail, which is
# off until the gateware turns on the channel supply.
BANK 0 VCCIO 3.3 V;
BANK 1 VCCIO 1.8 V;
BANK 2 VCCIO 3.3 V;
BANK 4 VCCIO 1.8 V;

# --- Timing -----------------------------------------------------------------
#
# clk is the internal oscillator (OSCH). The host SPI runs on its own SCLK;
# reads cross from the clk domain into it, writes cross back through a
# synchroniser (see host_spi_slave.vhd), so paths between the domains are
# not timed. Inputs are asynchronous to every clock.
FREQUENCY NET  "clk"         24.18 MHz;
FREQUENCY PORT "sync_clk_i"  8.192 MHz;
FREQUENCY PORT "host_sclk_i" 20 MHz;
BLOCK INTERCLOCKDOMAIN PATHS;
BLOCK ASYNCPATHS;
BLOCK RESETPATHS;

# --- Stack interconnect, through the SN74LVC244A bus buffer (bank 0, 2) ---
# A44  sync_clk_i      PT18A/PCLKT0_1  HOST.CLK
# A41  sync_start_i    PT21A           HOST.START
# A15  host_cs_n_i     PB7B            HOST.CS
# A17  host_sclk_i     PB13A/PCLKT2_0  HOST.SCLK
# B13  host_mosi_i     PB13B           HOST.MOSI
# B15  host_miso_o     PB20A           HOST.MISO
LOCATE COMP "sync_clk_i" SITE "A44";
LOCATE COMP "sync_start_i" SITE "A41";
LOCATE COMP "host_cs_n_i" SITE "A15";
LOCATE COMP "host_sclk_i" SITE "A17";
LOCATE COMP "host_mosi_i" SITE "B13";
LOCATE COMP "host_miso_o" SITE "B15";
IOBUF PORT "sync_clk_i"   IO_TYPE=LVCMOS33 PULLMODE=NONE;
IOBUF PORT "sync_start_i" IO_TYPE=LVCMOS33 PULLMODE=NONE;
IOBUF PORT "host_cs_n_i"  IO_TYPE=LVCMOS33 PULLMODE=NONE;
IOBUF PORT "host_sclk_i"  IO_TYPE=LVCMOS33 PULLMODE=NONE;
IOBUF PORT "host_mosi_i"  IO_TYPE=LVCMOS33 PULLMODE=NONE;
IOBUF PORT "host_miso_o"  IO_TYPE=LVCMOS33 PULLMODE=NONE;

# --- Channel supply eFuse, TPS25200 (bank 2) ---
# A11  adc_en_o        PB3B  ADC_EN, 100k pull-down on the board
# A13  adc_flt_n_i     PB4B  ADC_FLT, pull-up on the board
LOCATE COMP "adc_en_o" SITE "A11";
LOCATE COMP "adc_flt_n_i" SITE "A13";
IOBUF PORT "adc_en_o"    IO_TYPE=LVCMOS33;
IOBUF PORT "adc_flt_n_i" IO_TYPE=LVCMOS33 PULLMODE=NONE;

# --- ADC1, U9, bank 1 at 1.8 V; outputs through 62R at the FPGA ---
# A27  adc1_clk_o      PR10A/PCLKT1_0  via R213
# B20  adc1_start_o    PR10B           via R214
# A28  adc1_sclk_o     PR9A            via R215
# B21  adc1_sdi_o      PR9B            via R216
# B22  adc1_cs_n_o     PR8A            via R217
# A30  adc1_sdo_i      PR6A
# B23  adc1_dout_i     PR6B
# A31  adc1_fsync_i    PR3A
# A33  adc1_reset_n_o  PR2A
LOCATE COMP "adc1_clk_o" SITE "A27";
LOCATE COMP "adc1_start_o" SITE "B20";
LOCATE COMP "adc1_sclk_o" SITE "A28";
LOCATE COMP "adc1_sdi_o" SITE "B21";
LOCATE COMP "adc1_cs_n_o" SITE "B22";
LOCATE COMP "adc1_sdo_i" SITE "A30";
LOCATE COMP "adc1_dout_i" SITE "B23";
LOCATE COMP "adc1_fsync_i" SITE "A31";
LOCATE COMP "adc1_reset_n_o" SITE "A33";
IOBUF PORT "adc1_clk_o"     IO_TYPE=LVCMOS18;
IOBUF PORT "adc1_start_o"   IO_TYPE=LVCMOS18;
IOBUF PORT "adc1_sclk_o"    IO_TYPE=LVCMOS18;
IOBUF PORT "adc1_sdi_o"     IO_TYPE=LVCMOS18;
IOBUF PORT "adc1_cs_n_o"    IO_TYPE=LVCMOS18;
IOBUF PORT "adc1_sdo_i"     IO_TYPE=LVCMOS18 PULLMODE=DOWN;
IOBUF PORT "adc1_dout_i"    IO_TYPE=LVCMOS18 PULLMODE=DOWN;
IOBUF PORT "adc1_fsync_i"   IO_TYPE=LVCMOS18 PULLMODE=DOWN;
IOBUF PORT "adc1_reset_n_o" IO_TYPE=LVCMOS18;

# --- ADC2, U45, bank 4 at 1.8 V; outputs through 62R at the FPGA ---
# A5   adc2_clk_o      PL9A            via R218
# A7   adc2_start_o    PL10D/PCLKC4_0  via R219
# B5   adc2_sclk_o     PL10C/PCLKT4_0  via R220
# A6   adc2_sdi_o      PL10B           via R221
# B4   adc2_cs_n_o     PL10A           via R222
# A8   adc2_sdo_i      PL13A
# A9   adc2_dout_i     PL13B
# B7   adc2_fsync_i    PL14A
# B8   adc2_reset_n_o  PL14B
LOCATE COMP "adc2_clk_o" SITE "A5";
LOCATE COMP "adc2_start_o" SITE "A7";
LOCATE COMP "adc2_sclk_o" SITE "B5";
LOCATE COMP "adc2_sdi_o" SITE "A6";
LOCATE COMP "adc2_cs_n_o" SITE "B4";
LOCATE COMP "adc2_sdo_i" SITE "A8";
LOCATE COMP "adc2_dout_i" SITE "A9";
LOCATE COMP "adc2_fsync_i" SITE "B7";
LOCATE COMP "adc2_reset_n_o" SITE "B8";
IOBUF PORT "adc2_clk_o"     IO_TYPE=LVCMOS18;
IOBUF PORT "adc2_start_o"   IO_TYPE=LVCMOS18;
IOBUF PORT "adc2_sclk_o"    IO_TYPE=LVCMOS18;
IOBUF PORT "adc2_sdi_o"     IO_TYPE=LVCMOS18;
IOBUF PORT "adc2_cs_n_o"    IO_TYPE=LVCMOS18;
IOBUF PORT "adc2_sdo_i"     IO_TYPE=LVCMOS18 PULLMODE=DOWN;
IOBUF PORT "adc2_dout_i"    IO_TYPE=LVCMOS18 PULLMODE=DOWN;
IOBUF PORT "adc2_fsync_i"   IO_TYPE=LVCMOS18 PULLMODE=DOWN;
IOBUF PORT "adc2_reset_n_o" IO_TYPE=LVCMOS18;
