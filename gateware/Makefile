# e003-adc-board bring-up gateware.
#
# In the container (started for you, see docker/run):
#   make sim          simulate with GHDL; prints "tb_e003_top: PASS"
#   make build        Diamond: synthesis to bitstream, build/e003_top.{bit,jed}
#
# Native, on the Mac:
#   make image        build the container image (needs the Diamond installer)
#   make installer-info  describe the installer, if `make image` cannot use it
#   make shell        a shell in the container
#   make wave         open the last simulation's waveforms
#   make detect       check that the J-Link sees the FPGA over JTAG
#   make prog         load build/e003_top.bit into SRAM (lost at power-off)
#   make prog-flash   write build/e003_top.jed to the internal flash
#   make clean
#
# Override any variable on the command line, e.g. `make build SYNTH=synplify`.

SHELL := /bin/bash

TOP    := e003_top
DEVICE := LCMXO2-4000HC-4QN84C
LPF    := constraints/$(TOP).lpf
BUILD  := build

# Diamond's synthesis engine: lse (Lattice Synthesis Engine) or synplify.
SYNTH ?= lse

IMAGE ?= e003-gateware
export E003_IMAGE := $(IMAGE)

# Native tools
OPENFPGALOADER ?= openFPGALoader
WAVE_VIEWER    ?= surfer
# JTAG programmer and its clock. 1 MHz is slow and safe through the
# Tag-Connect cable; raise it once programming is reliable.
CABLE   ?= jlink
JTAG_HZ ?= 1000000

GEN_PKG := $(BUILD)/gen/e003_build_pkg.vhd

RTL := \
	rtl/e003_pkg.vhd \
	$(GEN_PKG) \
	rtl/host_spi_slave.vhd \
	rtl/adc_spi_master.vhd \
	rtl/adc_ctrl.vhd \
	rtl/clk_meter.vhd \
	rtl/$(TOP).vhd

SIM := \
	sim/osch_sim.vhd \
	sim/adc_model.vhd \
	sim/tb_$(TOP).vhd

BIT := $(BUILD)/$(TOP).bit
JED := $(BUILD)/$(TOP).jed
FST := $(BUILD)/sim/tb_$(TOP).fst

.PHONY: all sim build image installer-info shell wave detect prog prog-flash clean FORCE

all: build

ifndef E003_IN_CONTAINER

# --- On the host: hand the container targets to the container ---------------

sim build:
	./docker/run make $@ SYNTH=$(SYNTH)

else

# --- In the container ---------------------------------------------------------

# Build ID: the short git hash, plus 2^28 when gateware/ has uncommitted
# changes. Rewritten only when it changes, so it never forces a rebuild.
GIT_HASH  := $(shell git rev-parse --short=7 HEAD 2>/dev/null || echo 0)
GIT_DIRTY := $(shell git diff --quiet HEAD -- . 2>/dev/null && echo 0 || echo 1)

$(GEN_PKG): FORCE
	@mkdir -p $(dir $@)
	@printf '%s\n' \
	  "-- Generated by gateware/Makefile from git; do not edit." \
	  "package e003_build_pkg is" \
	  "  constant C_GIT_HASH : natural := 16#$(GIT_HASH)# + $(GIT_DIRTY) * 2**28;" \
	  "end package;" > $@.tmp
	@cmp -s $@.tmp $@ && rm $@.tmp || mv $@.tmp $@

# Simulation runs in build/sim, where GHDL keeps its library.
sim: $(GEN_PKG)
	mkdir -p $(BUILD)/sim
	cd $(BUILD)/sim && ghdl -a --std=08 $(abspath $(RTL) $(SIM))
	cd $(BUILD)/sim && ghdl --elab-run --std=08 tb_$(TOP) --fst=$(notdir $(FST))

# Diamond builds a fresh project in build/diamond on every run.
build: $(GEN_PKG)
	@test -n "$$LM_LICENSE_FILE" || { echo "No Diamond licence: see README.md, Diamond licence"; exit 1; }
	rm -rf $(BUILD)/diamond
	mkdir -p $(BUILD)/diamond $(BUILD)/reports
	set -o pipefail; \
	E003_TOP=$(TOP) E003_DEVICE=$(DEVICE) E003_SYNTH=$(SYNTH) \
	E003_OUT=$(abspath $(BUILD)/diamond) E003_LPF=$(abspath $(LPF)) \
	E003_SOURCES="$(abspath $(RTL))" \
	pnmainc diamond/build.tcl 2>&1 | tee $(BUILD)/diamond.log
	cp $(BUILD)/diamond/impl1/*.bit $(BIT)
	cp $(BUILD)/diamond/impl1/*.jed $(JED)
	cp $(BUILD)/diamond/impl1/*.mrp $(BUILD)/diamond/impl1/*.par \
	   $(BUILD)/diamond/impl1/*.twr $(BUILD)/reports/ 2>/dev/null || true
	@echo
	@echo "Built $(BIT) and $(JED), build ID 0x$(GIT_HASH)$(if $(filter 1,$(GIT_DIRTY)), (uncommitted changes))"
	@echo "Reports: $(BUILD)/reports/ (.mrp map and utilisation, .par placement, .twr timing)"
	@grep -h -i -E "timing errors|constraints cover" $(BUILD)/reports/*.twr 2>/dev/null | sort -u || true

endif

# --- On the host --------------------------------------------------------------

image:
	docker build --platform linux/amd64 -t $(IMAGE) docker

# Describe the Diamond installer in docker/diamond/ without installing it.
installer-info:
	docker run --rm --platform linux/amd64 -v "$(abspath docker):/d:ro" ubuntu:22.04 \
	  bash /d/install-diamond.sh --info /d/diamond

shell:
	./docker/run bash

wave:
	$(WAVE_VIEWER) $(FST)

detect:
	$(OPENFPGALOADER) -c $(CABLE) --freq $(JTAG_HZ) --detect

prog:
	@test -f $(BIT) || { echo "No $(BIT): run make build first"; exit 1; }
	$(OPENFPGALOADER) -c $(CABLE) --freq $(JTAG_HZ) $(BIT)

prog-flash:
	@test -f $(JED) || { echo "No $(JED): run make build first"; exit 1; }
	$(OPENFPGALOADER) -c $(CABLE) --freq $(JTAG_HZ) $(JED)

clean:
	rm -rf $(BUILD)
