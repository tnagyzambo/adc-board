		(uuid "c5d541a3-2c17-52b9-9f41-2a49b4cde28a")
	)
	(text "CHANNEL SUPPLY LIMIT: TPS25200 eFUSE AT 0.65 A (150k, 0.59 TO 0.71 A).\n+5V_CH IS THE STACK'S 5 V; THE FPGA SWITCHES IT AND READS THE FAULT FLAG.\nIN WITHSTANDS 20 V, ABOVE THE TVS0500'S 9.2 V CLAMP (STACK SHEET);\nOUT CLAMPS AT 5.4 V, AND IN ABOVE 7.6 V TURNS IT OFF"
		(exclude_from_sim no)
		(at 17.78 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
