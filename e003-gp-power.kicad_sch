	(text "LM2776 CHARGE PUMP: -5V_CH FROM THE LIMITED +5V_CH, 200 mA, 2 MHz, 2.5 OHM.\nTHE CHANNELS DRAW UP TO 0.09 A FROM IT, SO -5V_CH SITS NEAR -4.8 V"
		(exclude_from_sim no)
		(at 86.36 73.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1e3f1e79-338a-5acc-9e9b-4dabe78f47e3")
	)
	(text "TPS7A39: +/-2.5 V, OUTPUTS RISE TOGETHER\nVOUT+ = 1.2 V (1 + 11.0k / 10k)\nVOUT- = -1.2 V x 21.0k / 10k"
		(exclude_from_sim no)
		(at 17.78 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "419d2d5e-dc93-58da-aa57-1195e026184a")
	)
	(text "24 V SENSOR SUPPLY: +24V_CH COMES FROM THE STACK'S 24 V\nTHROUGH A PTC FUSE AND A TVS2700 (STACK SHEET), INTO\nEACH CHANNEL'S LT3092 (EXCITATION SHEETS)"
		(exclude_from_sim no)
		(at 203.2 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6e99b31c-75b5-54f8-ad16-e6508c0cc23c")
	)
	(text "+2.5 V SHUNT CLAMP AT 2.7 V = 1.24 V (1 + 118k / 100k):\nSINKS UP TO 35 mA, ENOUGH FOR THE FOUR SIGNAL BUFFERS OF\nBOTH CHANNELS DRIVEN PAST THEIR RANGE AT ONCE (8 mA EACH\nINTO THE CONVERTERS' CLAMPS). DRAWS NOTHING IN NORMAL OPERATION"
		(exclude_from_sim no)
		(at 200.66 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b9657603-976a-59d3-9e38-994fea51aa80")
	)
	(text "RAIL TEST POINTS"
