				(size 1.27 1.27)
			)
			(justify bottom)
		)
		(uuid "a9c90648-076c-5f91-96ba-d7a62f537c0b")
	)
	(text "MCLK 1k (DUAL BOOT), CSSPIN 10k, SN 10k, SI 10k\n(FPGA-TN-02155); TCK 4.7k DOWN"
		(exclude_from_sim no)
		(at 256.54 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b4be624a-8d2a-5093-a62d-dc877c499195")
	)
	(text "GOLDEN IMAGE: W25Q16JV ON THE MASTER SPI PINS (MCLK, SISPI, SPISO,\nCSSPIN), SHARED WITH THE SLAVE SPI PORT THAT THE HOST USES; DUAL BOOT\nLOADS IT ONLY WHEN THE INTERNAL IMAGE FAILS"
		(exclude_from_sim no)
		(at 256.54 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bc179f74-afd0-5c13-8169-87a2cf6ab3da")
	)
