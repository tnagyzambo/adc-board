	(text "62R SERIES RESISTORS AT THE FPGA'S\nOUTPUTS TO THE CONVERTERS: CLK, START,\nSCLK, SDI AND CS OF EACH CHANNEL"
		(exclude_from_sim no)
		(at 167.64 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0eea7115-d7ac-52cd-b0d3-f1304cf12d27")
	)
	(text "BANKS 1 AND 4 AT 1.8 V (+1V8_CH) FACE THE CONVERTERS, ONE EACH, WITH EACH CONVERTER'S RESET; BANKS 0 AND 2 AT 3.3 V.\nBANK 2 HOLDS THE CONFIGURATION SPI PINS: THE HOST'S SLAVE SPI (CCLK, SI, SO, SN) AND THE GOLDEN-IMAGE FLASH'S MASTER SPI\n(MCLK, SISPI, SPISO, CSSPIN). THE HOST'S CHIP SELECT ALSO GOES TO PB7B, THE USER SPI'S CHIP SELECT (SPI_SCSN)"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4dc3d776-735c-51bb-a6af-c74bda6f3007")
	)
	(text "RECONFIGURATION (GW-9): THE HOST SENDS REFRESH (0x79 00 00) TO THE SLAVE SPI\nPORT, WHICH EVERY IMAGE KEEPS ENABLED: THE HARDENED CONFIGURATION LOGIC\nRELOADS THE FPGA WHATEVER THE USER DESIGN IS DOING. PROGRAMN IS OPEN\n(WEAK PULL-UP IN A BLANK DEVICE)"
		(exclude_from_sim no)
		(at 256.54 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "816368fd-a33b-585d-9a58-77a9bd6ff3d3")
	)
	(text "VCC"
		(exclude_from_sim no)
		(at 30.48 171.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify bottom)
		)
		(uuid "a66bc241-f9e7-50c4-8081-78eea3a5a796")
	)
	(text "VCCIO1"
		(exclude_from_sim no)
		(at 147.32 171.45 0)
		(effects
